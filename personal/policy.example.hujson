{
  "tagOwners": {
    "tag:monitor": ["autogroup:admin"],
    "tag:server": ["autogroup:admin"]
  },
  "grants": [
    {"src": ["admin@example.com"], "dst": ["tag:server"], "ip": ["tcp:22"]},
    {"src": ["tag:monitor"], "dst": ["tag:server"], "ip": ["tcp:9100"]}
  ],
  "tests": [
    {"src": "admin@example.com", "accept": ["tag:server:22"], "deny": ["tag:server:9100"]},
    {"src": "tag:monitor", "accept": ["tag:server:9100"], "deny": ["tag:server:22"]},
    {"src": "tag:server", "deny": ["tag:server:22", "tag:server:9100"]}
  ]
}
